{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": {
        "APP_ENV": "dev"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": {
        "APP_ENV": "qa"
      },
      "channel": "preview",
      "distribution": "internal"
    },
    "production": {
      "env": {
        "APP_ENV": "prod"
      },
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "playstore_production": {
      "env": {
        "APP_ENV": "prod"
      },
      "channel": "production"
    },
    "explore_it_first": {
      "env": {
        "APP_ENV": "prod"
      },
      "autoIncrement": true,
      "channel": "explore_it_first"
    }
  },
  "submit": {
    "production": {}
  }
}
